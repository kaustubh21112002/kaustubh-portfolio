{
  "name": "kaustubh-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:resume": "node --experimental-strip-types scripts/generate_resume_pdf.mjs",
    "typecheck:app": "tsc",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "typecheck": "tsc && tsc -p tsconfig.api.json",
    "build": "tsc && tsc -p tsconfig.api.json && vite build",
    "vercel-build": "tsc && tsc -p tsconfig.api.json && vite build",
    "preview": "vite preview",
    "test:analytics": "node --experimental-strip-types scripts/test_analytics_contract_v2.mjs",
    "build:resume:canonical": "node --experimental-strip-types scripts/generate_resume_pdf.mjs --overwrite-canonical"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
